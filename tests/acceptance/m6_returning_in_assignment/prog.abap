REPORT ztest.
CLASS lcl DEFINITION.
  PUBLIC SECTION.
    DATA v TYPE i.
    METHODS get RETURNING VALUE(r) TYPE i.
ENDCLASS.
CLASS lcl IMPLEMENTATION.
  METHOD get.
    r = v * 2.
  ENDMETHOD.
ENDCLASS.
DATA o TYPE REF TO lcl.
DATA x TYPE i.
START-OF-SELECTION.
  CREATE OBJECT o.
  o->v = 5.
  x = o->get( ) + 1.
  WRITE x.
