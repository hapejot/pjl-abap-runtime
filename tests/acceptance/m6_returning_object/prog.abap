REPORT ztest.
CLASS lcl DEFINITION.
  PUBLIC SECTION.
    DATA v TYPE i.
    METHODS make RETURNING VALUE(r) TYPE REF TO lcl.
ENDCLASS.
CLASS lcl IMPLEMENTATION.
  METHOD make.
    CREATE OBJECT r.
    r->v = 9.
  ENDMETHOD.
ENDCLASS.
DATA o TYPE REF TO lcl.
DATA p TYPE REF TO lcl.
START-OF-SELECTION.
  CREATE OBJECT o.
  p = o->make( ).
  WRITE p->v.
