REPORT ztest.
CLASS lcl DEFINITION.
  PUBLIC SECTION.
    METHODS up CHANGING x TYPE i.
ENDCLASS.
CLASS lcl IMPLEMENTATION.
  METHOD up.
    x = x + 100.
  ENDMETHOD.
ENDCLASS.
DATA o TYPE REF TO lcl.
DATA n TYPE i.
START-OF-SELECTION.
  CREATE OBJECT o.
  n = 1.
  o->up( CHANGING x = n ).
  WRITE n.
