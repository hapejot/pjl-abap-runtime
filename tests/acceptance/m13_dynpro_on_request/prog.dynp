* Dynpro 0100: Ablauf-Zusätze ON REQUEST, ON INPUT, CHAIN
DYNPRO 0100
  SIZE 20 80
  TITLE 'Kunde'
  TEXT 2 2 'Kundennummer'
  FIELD ZKUNNR 2 20 INPUT
  TEXT 4 2 'Name'
  FIELD ZNAME 4 20 INPUT
  TEXT 6 2 'Werk'
  FIELD ZWERK 6 20 INPUT
  TEXT 7 2 'Lagerort'
  FIELD ZLGORT 7 20 INPUT

  FLOW
    PROCESS BEFORE OUTPUT
      MODULE STATUS_0100
    PROCESS AFTER INPUT
      FIELD ZKUNNR MODULE CHECK_KUNNR ON REQUEST
      FIELD ZNAME MODULE CHECK_NAME ON INPUT
      CHAIN
        FIELD ZWERK
        FIELD ZLGORT
        MODULE CHECK_CHAIN ON CHAIN-REQUEST
      ENDCHAIN
      MODULE USER_COMMAND_0100
  ENDFLOW
ENDDYNPRO

GUISTATUS STATUS_0100
  FKEY F3 'Back' CODE BACK TYPE B
ENDGUISTATUS
