REPORT ztest.
CLASS lcl DEFINITION.
  PUBLIC SECTION.
    METHODS sum IMPORTING a TYPE i b TYPE i RETURNING VALUE(r) TYPE i.
ENDCLASS.
CLASS lcl IMPLEMENTATION.
  METHOD sum.
    r = a + b.
  ENDMETHOD.
ENDCLASS.
DATA o TYPE REF TO lcl.
DATA x TYPE i.
START-OF-SELECTION.
  CREATE OBJECT o.
  x = o->sum( a = 2 b = 3 ).
  WRITE x.
