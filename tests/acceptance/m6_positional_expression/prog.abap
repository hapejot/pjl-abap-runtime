REPORT ztest.
CLASS lcl DEFINITION.
  PUBLIC SECTION.
    METHODS sq IMPORTING a TYPE i RETURNING VALUE(r) TYPE i.
ENDCLASS.
CLASS lcl IMPLEMENTATION.
  METHOD sq.
    r = a * a.
  ENDMETHOD.
ENDCLASS.
DATA o TYPE REF TO lcl.
DATA x TYPE i.
START-OF-SELECTION.
  CREATE OBJECT o.
  x = 3.
  WRITE o->sq( x + 1 ).
