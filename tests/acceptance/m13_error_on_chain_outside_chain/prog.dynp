* MODULE ... ON CHAIN-INPUT steht außerhalb einer CHAIN: Übersetzungsfehler (Spec 12a)
DYNPRO 0100
  SIZE 20 80
  TITLE 'Kunde anlegen'
  TEXT 2 2 'Kundennummer'
  FIELD ZKUNNR 2 20 INPUT

  FLOW
    PROCESS BEFORE OUTPUT
      MODULE STATUS_0100
    PROCESS AFTER INPUT
      FIELD ZKUNNR
      MODULE CHECK_KUNNR ON CHAIN-INPUT
      MODULE USER_COMMAND_0100
  ENDFLOW
ENDDYNPRO
