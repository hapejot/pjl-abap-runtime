REPORT ztest.
CLASS lcl DEFINITION.
  PUBLIC SECTION.
    DATA v TYPE i.
    METHODS add IMPORTING n TYPE i.
ENDCLASS.
CLASS lcl IMPLEMENTATION.
  METHOD add.
    v = v + n.
  ENDMETHOD.
ENDCLASS.
DATA a TYPE REF TO lcl.
DATA b TYPE REF TO lcl.
START-OF-SELECTION.
  CREATE OBJECT a.
  CREATE OBJECT b.
  a->add( 3 ).
  WRITE a->v.
  WRITE / b->v.
