REPORT ztest.
CLASS lcl DEFINITION.
  PUBLIC SECTION.
    METHODS sum IMPORTING a TYPE i b TYPE i RETURNING VALUE(r) TYPE i.
    METHODS up CHANGING x TYPE i.
ENDCLASS.
CLASS lcl IMPLEMENTATION.
  METHOD sum.
    r = a + b.
  ENDMETHOD.
  METHOD up.
    x = x + 100.
  ENDMETHOD.
ENDCLASS.
DATA o TYPE REF TO lcl.
DATA n TYPE i.
START-OF-SELECTION.
  CREATE OBJECT o.
  n = 1.
  CALL METHOD o->up CHANGING x = n.
  WRITE n.
