* Dynpro 0100: Hauptbild. F5 öffnet das Modalfenster 0200 (STARTING AT 10 5 ENDING AT 60 15).
DYNPRO 0100
  SIZE 20 80
  TITLE 'Kunde anlegen'

  TEXT 2 2 'Name'
  FIELD ZNAME1 2 20 INPUT
  TEXT 10 2 'Fenster mit F5'

  FLOW
    PROCESS BEFORE OUTPUT
      MODULE STATUS_0100
    PROCESS AFTER INPUT
      MODULE USER_COMMAND_0100
  ENDFLOW
ENDDYNPRO

* Dynpro 0200: Modalfenster. Innenfläche 9 x 49 (aus ENDING AT).
DYNPRO 0200 KIND MODAL
  SIZE 9 49
  TITLE 'Name erfassen'

  TEXT 2 2 'Name'
  FIELD ZNAME1 2 10 INPUT
  TEXT 4 2 'Enter a name, then press F3'

  FLOW
    PROCESS BEFORE OUTPUT
      MODULE STATUS_0200
    PROCESS AFTER INPUT
      MODULE USER_COMMAND_0200
  ENDFLOW
ENDDYNPRO

GUISTATUS STATUS_0100
  FKEY F3  'Back'   CODE BACK   TYPE B
  FKEY F5  'Window' CODE POPUP
  FKEY F12 'Cancel' CODE CANCEL TYPE C
  FKEY F15 'Exit'   CODE EXIT   TYPE E
ENDGUISTATUS

GUISTATUS STATUS_0200
  FKEY F3 'Back' CODE BACK TYPE B
ENDGUISTATUS
