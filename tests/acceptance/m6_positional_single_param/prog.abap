REPORT ztest.
CLASS lcl DEFINITION.
  PUBLIC SECTION.
    METHODS twice IMPORTING s TYPE string RETURNING VALUE(r) TYPE string.
ENDCLASS.
CLASS lcl IMPLEMENTATION.
  METHOD twice.
    r = s && s.
  ENDMETHOD.
ENDCLASS.
DATA o TYPE REF TO lcl.
START-OF-SELECTION.
  CREATE OBJECT o.
  WRITE o->twice( 'ab' ).
