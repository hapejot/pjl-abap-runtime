* CRM-Demo. Dynpro 0100: Kunde (Stammdaten, Blättern, Anlegen, Ändern, Löschen).
DYNPRO 0100
  SIZE 20 80
  TITLE 'CRM: Kunde'

  TEXT 2 2 'Kundennummer'
  FIELD ZKUNNR 2 24 INPUT
  TEXT 4 2 'Name'
  FIELD ZNAME 4 24 INPUT REQUIRED
  TEXT 6 2 'Ort'
  FIELD ZORT 6 24 INPUT
  TEXT 8 2 'Branche'
  FIELD ZBRANCHE 8 24 INPUT
  TEXT 10 2 'Kontakte'
  FIELD ZNKONT 10 24 OUTPUT
  TEXT 12 2 'Verkaufschancen'
  FIELD ZNCHANCE 12 24 OUTPUT
  FIELD ZINFO 17 2 OUTPUT

  FLOW
    PROCESS BEFORE OUTPUT
      MODULE STATUS_0100
    PROCESS AFTER INPUT
      MODULE USER_COMMAND_0100
  ENDFLOW
ENDDYNPRO

* Dynpro 0200: Kontakt und Verkaufschance des gewählten Kunden, je ein Block.
DYNPRO 0200
  SIZE 20 80
  TITLE 'Kontakte und Verkaufschancen'

  TEXT 1 2 'Kunde'
  FIELD ZNAME 1 24 OUTPUT
  TEXT 3 2 'KONTAKT'
  TEXT 4 2 'Kontaktnummer'
  FIELD ZKNR 4 24 OUTPUT
  TEXT 5 2 'Vorname'
  FIELD ZVORNAME 5 24 INPUT
  TEXT 6 2 'Nachname'
  FIELD ZNACHNAME 6 24 INPUT
  TEXT 7 2 'E-Mail'
  FIELD ZEMAIL 7 24 INPUT
  TEXT 8 2 'Telefon'
  FIELD ZTELEFON 8 24 INPUT
  TEXT 9 2 'Position'
  FIELD ZKPOS 9 24 OUTPUT
  TEXT 11 2 'VERKAUFSCHANCE'
  TEXT 12 2 'Chancennummer'
  FIELD ZCNR 12 24 OUTPUT
  TEXT 13 2 'Titel'
  FIELD ZTITEL 13 24 INPUT
  TEXT 14 2 'Wert (EUR)'
  FIELD ZWERT 14 24 INPUT
  TEXT 15 2 'Phase'
  FIELD ZPHASE 15 24 INPUT
  TEXT 16 2 'Abschluss JJJJMMTT'
  FIELD ZABSCHLUSS 16 24 INPUT
  TEXT 17 2 'Position'
  FIELD ZCPOS 17 24 OUTPUT
  FIELD ZINFO 19 2 OUTPUT

  FLOW
    PROCESS BEFORE OUTPUT
      MODULE STATUS_0200
    PROCESS AFTER INPUT
      MODULE USER_COMMAND_0200
    PROCESS ON VALUE-REQUEST
      FIELD ZPHASE MODULE F4_PHASE
  ENDFLOW
ENDDYNPRO

* Dynpro 0300: Bestätigung als Modalfenster (CALL SCREEN 0300 STARTING AT 10 8).
DYNPRO 0300 KIND MODAL
  SIZE 5 60
  TITLE 'Löschen bestätigen'

  FIELD ZFRAGE 2 2 OUTPUT
  TEXT 4 2 'F5 = Ja     F12 = Nein'

  FLOW
    PROCESS BEFORE OUTPUT
      MODULE STATUS_0300
    PROCESS AFTER INPUT
      MODULE USER_COMMAND_0300
  ENDFLOW
ENDDYNPRO

GUISTATUS STATUS_0100
  FKEY F2 'Sichern' CODE SAVE
  FKEY F3 'Zurück' CODE BACK TYPE B
  FKEY F4 'Kontakte' CODE KONTAKT
  FKEY F5 '<Kunde' CODE PREV
  FKEY F6 'Kunde>' CODE NEXT
  FKEY F7 'Neu' CODE NEW
  FKEY F8 'Abbruch' CODE CANCEL TYPE C
  FKEY F9 'Löschen' CODE DELETE
ENDGUISTATUS

GUISTATUS STATUS_0200
  FKEY F3 'Zurück' CODE BACK TYPE B
  FKEY F5 '<Chance' CODE CPREV
  FKEY F6 'Chance>' CODE CNEXT
  FKEY F7 '<Kontakt' CODE KPREV
  FKEY F8 'Kontakt>' CODE KNEXT
  FKEY F9 'KNeu' CODE KNEW
  FKEY F10 'CNeu' CODE CNEW
  FKEY F11 'Sichern' CODE SAVE
  FKEY F12 'Abbruch' CODE CANCEL TYPE C
  FKEY F14 'KLöschen' CODE KDEL
  FKEY F15 'CLöschen' CODE CDEL
ENDGUISTATUS

GUISTATUS STATUS_0300
  FKEY F5 'Ja' CODE YES
  FKEY F12 'Nein' CODE CANCEL TYPE C
ENDGUISTATUS
